# Copy this file to .env and fill in real values.
# .env is gitignored -- .env.example (this file) is what gets committed,
# with placeholders only, so collaborators know what's required.

# Primary LLM provider -- required
GROQ_API_KEY=
# Fallback LLM providers -- optional (used only if Groq errors/rate-limits)
# Chain: Groq → OpenAI → OpenRouter (only the keys you set are wired in)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Researcher agent's web search tool -- optional (stub results without it)
TAVILY_API_KEY=

# Optional: LangSmith tracing
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=research-code-review-agent

# Optional per-role model overrides -- see tools/llm_provider.py for defaults
# CODER_MODEL_GROQ=llama-3.3-70b-versatile
# CODER_MODEL_OPENAI=gpt-4o
# CODER_MODEL_OPENROUTER=openai/gpt-4o
# RESEARCHER_MODEL_GROQ=llama-3.1-8b-instant
# RESEARCHER_MODEL_OPENAI=gpt-4o-mini
# RESEARCHER_MODEL_OPENROUTER=openai/gpt-4o-mini
